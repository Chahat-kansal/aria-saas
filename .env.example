# ──────────────────────────────────────────────────────────────────────────────
# Aria OS — environment variables
# Copy to .env.local and fill in. NEVER commit real values. NEXT_PUBLIC_* are exposed
# to the browser (no secrets there). Most integrations are OPTIONAL — the app degrades
# gracefully when a key is missing. Required vars are marked [REQUIRED].
# (NODE_ENV / NEXT_RUNTIME are set by Next.js — do not define them here.)
# ──────────────────────────────────────────────────────────────────────────────

# ── Core: Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=                 # [REQUIRED] https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # [REQUIRED] anon/publishable key (browser)
SUPABASE_SERVICE_ROLE_KEY=               # [REQUIRED] service-role key — SERVER ONLY, full DB access

# ── App URLs / public config ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=                      # [REQUIRED] e.g. https://www.ariaos.site
NEXT_PUBLIC_URL=                          # public site URL (sitemap/robots)
NEXT_PUBLIC_BASE_URL=                     # base URL (Xero OAuth redirects)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_ARIA_AVATAR_URL=
NEXT_PUBLIC_ARIA_VIDEO_URL=
NEXT_PUBLIC_ENABLE_VISA_MODULE=           # feature flag: 'true' to enable the visa module
NAV_FASTPATH=                             # internal nav perf flag

# ── Security secrets (SERVER ONLY) ─────────────────────────────────────────────
CRON_SECRET=                              # [REQUIRED] Bearer secret for /api/cron/* (Vercel cron auth)
MANAGER_TOKEN_SECRET=                     # signs POS manager-override tokens
INTEGRATION_TOKEN_KEY=                    # encrypts stored 3rd-party integration tokens
ARIA_MASTER_ENCRYPTION_KEY=               # customer-PII encryption key (SEC-4)
UNSUBSCRIBE_SECRET=                       # signs email List-Unsubscribe tokens (defaults to service-role key if unset)
CLICKSEND_INBOUND_SECRET=                 # shared secret for the ClickSend inbound-SMS webhook
ADMIN_EMAILS=                             # comma-separated admin emails

# ── AI / models ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                        # [REQUIRED] Claude models
OPENAI_API_KEY=                           # optional (judge/fallback)
GEMINI_API_KEY=                           # optional
OPENROUTER_API_KEY=                       # optional model router
OPENROUTER_APP_NAME=
OPENROUTER_SITE_URL=
PERPLEXITY_API_KEY=                       # optional research
ARIA_USE_OPENAI_JUDGE=                    # 'true' to use OpenAI as grounding judge
ARIA_DAILY_COST_CEILING=                  # daily AI spend cap (dollars)
ARIA_RATE_LIMIT_PER_MIN=                  # per-business AI rate (default 30)

# ── Payments: Stripe ───────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_IMAGE_CREDITS=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_PRO=
STRIPE_ADDITIONAL_BUSINESS_PRICE_ID=
STRIPE_REELS_PRICE_ID=

# ── Email: Resend (active provider) ────────────────────────────────────────────
RESEND_API_KEY=                           # transactional + marketing email (the email chokepoint)
RESEND_FROM_DOMAIN=                       # verified sending domain, e.g. ariaos.site

# ── SMS: ClickSend (active provider) ───────────────────────────────────────────
CLICKSEND_USERNAME=                       # ClickSend account username
CLICKSEND_API_KEY=                        # ClickSend API key

# ── Rate limiting (optional) ───────────────────────────────────────────────────
# If unset, the auth/abuse limiter falls back to the atomic Supabase rate_limits table.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Web Push (VAPID) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                            # mailto: contact for push

# ── Monitoring ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_ORG=
SENTRY_AUTH_TOKEN=                        # build-time source-map upload (Vercel only)
SENTRY_DEBUG_SECRET=
SENTRY_WEBHOOK_SECRET=

# ── Storage / media ────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=                    # Vercel Blob
BUNNY_STREAM_API_KEY=                     # Bunny Stream (Go Live / reels)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_HOSTNAME=
CLOUDFLARE_ACCOUNT_ID=                    # Cloudflare Stream
CLOUDFLARE_STREAM_API_TOKEN=
FAL_API_KEY=                              # fal.ai media generation
REPLICATE_API_KEY=
STABILITY_AI_KEY=
ELEVENLABS_API_KEY=
HIGGSFIELD_API_KEY=
RUNWAY_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
PIXABAY_KEY=                              # legacy alias for PIXABAY_API_KEY
UNSPLASH_ACCESS_KEY=

# ── Accounting integrations ────────────────────────────────────────────────────
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
MYOB_CLIENT_ID=
MYOB_CLIENT_SECRET=

# ── POS / commerce integrations ────────────────────────────────────────────────
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_REDIRECT_URI=
SQUARE_ENVIRONMENT=                       # sandbox | production
SQUARE_WEBHOOK_SIGNATURE_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=
SHOPFRONT_CLIENT_ID=
LIGHTSPEED_X_CLIENT_ID=
LIGHTSPEED_X_CLIENT_SECRET=
LIGHTSPEED_X_REDIRECT_URI=
KOUNTA_CLIENT_ID=
KOUNTA_CLIENT_SECRET=
KOUNTA_REDIRECT_URI=

# ── Social / marketing integrations ────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_FBLB_CONFIG_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_VERIFICATION_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Google ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
GOOGLE_CALENDAR_TOKEN=
GMAIL_ACCESS_TOKEN=

# ── Banking / finance data ─────────────────────────────────────────────────────
BASIQ_API_KEY=
ALPHAVANTAGE_API_KEY=
ABN_LOOKUP_GUID=                          # Australian Business Register lookup

# ── Search / web / data APIs ───────────────────────────────────────────────────
SERPER_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=
GEOAPIFY_API_KEY=
OPENWEATHER_API_KEY=
RAPIDAPI_KEY=
TRACK17_API_KEY=                          # parcel tracking
GO_UPC_API_KEY=                           # barcode → product lookup

STAFF_PIN_PEPPER=replace-me-32-char-random  # [REQUIRED] HMAC pepper for pos_users/pos_staff pin_lookup.
                                          # ROTATING THIS INVALIDATES EVERY EXISTING pin_lookup VALUE.
                                          # See SEC-PIN-3 / staff-pin.ts before changing it.
# ── DEPRECATED — do not configure (kept only for back-compat) ──────────────────
# Twilio was dropped; SMS now runs entirely through ClickSend (above). These are dead.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_FROM_NUMBER=
# NEXT_PUBLIC_TWILIO_NUMBER=
# SENDGRID_API_KEY=   # legacy — only the trial-warnings cron still falls back to SendGrid;
                      # leave unset to skip it (or migrate that email to Resend/sendEmail).
