# ── AUTH ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-run-openssl-rand-base64-32

# ── ANTHROPIC ──
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── MONGODB ──
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aria?retryWrites=true&w=majority

# ── STRIPE ──
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key

# ── STRIPE PRICE IDs (create these in Stripe dashboard) ──
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxx

# ── VERCEL BLOB (auto-filled by Vercel) ──
BLOB_READ_WRITE_TOKEN=vercel_blob_token

# ── APP ──
NEXT_PUBLIC_APP_URL=https://aria.yourdomain.com

# OpenAI — for DALL-E 3 image generation
OPENAI_API_KEY=
