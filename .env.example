# ── SUPABASE ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── ANTHROPIC ──
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── OPENAI (DALL-E 3 image generation) ──
OPENAI_API_KEY=sk-proj-your-key-here

# ── STRIPE ──
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# ── STRIPE PRICE IDs (create in Stripe dashboard) ──
STRIPE_STARTER_PRICE_ID=price_xxx
STRIPE_GROWTH_PRICE_ID=price_xxx
STRIPE_PRO_PRICE_ID=price_xxx

# ── TWILIO (SMS for winback + review requests) ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+61400000000

# ── VERCEL BLOB ──
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token

# ── FIRECRAWL (web scraping for research) ──
FIRECRAWL_API_KEY=fc-your-key-here

# ── JUDGE0 (code execution) ──
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-key

# ── APP ──
NEXT_PUBLIC_APP_URL=https://aria.yourdomain.com
